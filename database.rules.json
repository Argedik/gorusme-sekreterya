{
  // Veriye yalnızca Firebase Authentication ile giriş yapmış kullanıcılar erişebilir.
  // Site adresi ve apiKey herkese açık olduğu için tek gerçek koruma buradaki auth kontrolü.
  // "oturum" dışındaki her yol varsayılan olarak kapalıdır.
  "rules": {
    "oturum": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
